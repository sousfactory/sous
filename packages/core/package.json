{
  "name": "sous-factory",
  "version": "0.1.0",
  "description": "A local software factory: runs an issue through a flow of agent prompts and TypeScript modules in a git worktree, with a live run viewer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inauditech/sous.git",
    "directory": "packages/core"
  },
  "keywords": [
    "agents",
    "claude",
    "codex",
    "workflow",
    "software-factory"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sous": "bin/sous.js"
  },
  "exports": {
    ".": {
      "sous-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./read": {
      "sous-source": "./src/read.ts",
      "types": "./dist/src/read.d.ts",
      "default": "./dist/src/read.js"
    },
    "./testing": {
      "sous-source": "./test/fakes/index.ts",
      "types": "./dist/test/fakes/index.d.ts",
      "default": "./dist/test/fakes/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "starter"
  ],
  "scripts": {
    "build:lib": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run build:lib && npm run build --prefix ../ui && npm run bundle",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "ajv": "^8.17.0",
    "tsx": "^4.19.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
