{
  "name": "sous-factory",
  "version": "0.2.0",
  "description": "A software factory for coding agents, on your machine. sous runs your software development flow with coding agents: implement, review, fix, merge, or any step you write. The flow is a deterministic graph in YAML, like a GitHub Actions workflow, so the agents do the work and the graph decides what happens next.",
  "license": "MIT",
  "homepage": "https://sousfactory.com",
  "bugs": "https://github.com/sousfactory/sous/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sousfactory/sous.git",
    "directory": "packages/core"
  },
  "keywords": [
    "agents",
    "claude",
    "codex",
    "workflow",
    "software-factory"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sous": "bin/sous.js"
  },
  "exports": {
    ".": {
      "sous-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./read": {
      "sous-source": "./src/read.ts",
      "types": "./dist/src/read.d.ts",
      "default": "./dist/src/read.js"
    },
    "./testing": {
      "sous-source": "./test/fakes/index.ts",
      "types": "./dist/test/fakes/index.d.ts",
      "default": "./dist/test/fakes/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "starter"
  ],
  "scripts": {
    "build:lib": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run build:lib && npm run build --prefix ../ui && npm run bundle",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "ajv": "^8.17.0",
    "tsx": "^4.19.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
